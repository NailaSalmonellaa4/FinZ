# FinZ — Environment Variables
# Salin file ini menjadi `.env` dan isi value-nya sesuai environment Anda.

# ─── Database ───────────────────────────────────────────────
# MySQL connection string (sesuaikan user, password, host, port, db_name)
DATABASE_URL="mysql://root:@localhost:3306/finz_db"

# ─── Authentication (JWT) ──────────────────────────────────
# Secret key untuk menandatangani JSON Web Token (minimum 32 karakter, acak)
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter-yang-sangat-rahasia"

# Durasi token JWT dalam hitungan jam (contoh: 24 = 24 jam)
JWT_EXPIRES_IN="24h"

# ─── Application ───────────────────────────────────────────
# URL dasar aplikasi (untuk development)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Bcrypt ────────────────────────────────────────────────
# Jumlah salt rounds untuk hashing password (minimum 10)
BCRYPT_SALT_ROUNDS="12"
